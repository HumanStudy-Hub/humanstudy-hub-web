# Required for Build Study. The browser uploads the paper straight to Blob
# because Vercel rejects function request bodies over 4.5 MB.
BLOB_READ_WRITE_TOKEN=

# Required for the daily blob cleanup cron; the route refuses to run without it.
CRON_SECRET=

GITHUB_JOBS_REPO=HumanStudy-Hub/humanstudy-hub-jobs
GITHUB_PIPELINE_REPO=HumanStudy-Hub/HumanStudy-Bench
GITHUB_PIPELINE_REF=main

# Required for the playground's persona designer chat, which calls OpenRouter
# from the server. Without it the designer is disabled and persona groups can
# still be built by hand. Playground *runs* use the Actions secret of the same
# name in HumanStudy-Bench, not this one.
OPENROUTER_API_KEY=
PERSONA_DESIGNER_MODEL=anthropic/claude-sonnet-5

# Required only for playground runs on a researcher's own OpenRouter key. The
# key is sealed with this secret before it is stored, and the same value must be
# set as the PLAYGROUND_KEY_SECRET Actions secret in HumanStudy-Bench.
PLAYGROUND_KEY_SECRET=

# Optional: enables "Save to GitHub". ZIP download works without it.
GITHUB_TOKEN=

# Optional: token used to read and write the private jobs repository (past
# runs, buffer studies, run creation). Falls back to GITHUB_TOKEN when unset.
# Set this to a token with Contents read/write on HumanStudy-Hub/humanstudy-hub-jobs
# when GITHUB_TOKEN is a deployment token that cannot reach that repository.
GITHUB_JOBS_TOKEN=
GITHUB_REPO_OWNER=HumanStudy-Hub
GITHUB_REPO_NAME=HumanStudy-Bench
GITHUB_BASE_BRANCH=main
